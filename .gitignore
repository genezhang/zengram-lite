# Build artifacts and generated engine binary — never committed.
# The compiled wasm is published to npm / GitHub Releases and fetched via
# scripts/fetch-artifact.sh into demo/pkg-web/.
demo/pkg-web/
demo/pkg/

# Node
node_modules/
*.log

# E2E screenshots (opt-in via E2E_SHOT=path)
demo/*.png

# OS / editor
.DS_Store
*.swp

# LaTeX build intermediates (docs/paper/tex). The figure PDFs are committed —
# arXiv cannot run Chrome/Inkscape, so the vector PDFs built by
# figures/build-figs.sh are the submission artifacts. The compiled main.pdf and
# transient aux files are not committed; run `latexmk -pdf main.tex` to rebuild.
docs/paper/tex/main.pdf
docs/paper/tex/*.aux
docs/paper/tex/*.fls
docs/paper/tex/*.fdb_latexmk
docs/paper/tex/*.out
docs/paper/tex/*.toc
docs/paper/tex/*.bbl
docs/paper/tex/*.blg
